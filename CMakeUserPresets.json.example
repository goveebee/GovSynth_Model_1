{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-debug-gcc14",
      "displayName": "Linux Debug GCC 14",
      "inherits": "linux-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    },
    {
      "name": "linux-release-gcc14",
      "displayName": "Linux Release GCC 14",
      "inherits": "linux-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    },
    {
      "name": "windows-release-vs2022",
      "displayName": "Windows Release VS2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-release-vs2022",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-debug-vs2022",
      "displayName": "Windows Debug VS2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-debug-vs2022",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
